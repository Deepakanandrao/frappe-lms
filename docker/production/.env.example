# =============================================================================
# FRAPPE LMS - PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and modify the values as needed.
# All variables have sensible defaults that work out of the box.
# =============================================================================

# -----------------------------------------------------------------------------
# SITE CONFIGURATION
# -----------------------------------------------------------------------------

# The site name for your LMS instance.
# This should match your domain name for production deployments.
# Examples: lms.localhost, learn.mycompany.com, training.example.org
SITE_NAME=lms.localhost

# -----------------------------------------------------------------------------
# ADMIN CREDENTIALS
# -----------------------------------------------------------------------------

# Password for the Frappe "Administrator" user.
# This is the superuser account for your LMS.
# IMPORTANT: Change this in production!
FRAPPE_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------

# MariaDB root password.
# Used for database administration and site creation.
# IMPORTANT: Change this in production!
MARIADB_ROOT_PASSWORD=admin

# -----------------------------------------------------------------------------
# IMAGE CONFIGURATION
# -----------------------------------------------------------------------------

# LMS Docker image version tag.
# Options: stable, latest, v1.x.x, main
LMS_VERSION=stable

# Image pull policy: always, if-not-present, never
PULL_POLICY=always

# -----------------------------------------------------------------------------
# NETWORK CONFIGURATION
# -----------------------------------------------------------------------------

# Port exposed on the host machine.
# The frontend (nginx) listens on port 8080 internally.
# Set to 80 for direct access, or use any available port.
# Note: When using Coolify, set this to 8080 and let Coolify handle the proxy.
HOST_EXPOSED_PORT=80

# Maximum upload file size (nginx client_max_body_size)
CLIENT_MAX_BODY_SIZE=50m

# Proxy read timeout in seconds
PROXY_READ_TIMEOUT=120

# -----------------------------------------------------------------------------
# REVERSE PROXY CONFIGURATION (Optional)
# -----------------------------------------------------------------------------
# These settings are for when LMS is behind a reverse proxy (like Coolify, Traefik, etc.)

# IP address of the upstream proxy
UPSTREAM_REAL_IP_ADDRESS=127.0.0.1

# Header containing the real client IP
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For

# Whether to recursively search for client IP in the header
UPSTREAM_REAL_IP_RECURSIVE=off
